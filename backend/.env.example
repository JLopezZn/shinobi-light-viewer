# Windows example paths
FOOTAGE_DIR=D:/ShinobiVideos
DB_PATH=C:/ProgramData/shinobi-viewer/shinobi_index.db
CACHE_DIR=C:/ProgramData/shinobi-viewer/cache
PORT=8090
SCAN_INTERVAL_SECONDS=60

# Docker container management
SHINOBI_CONTAINER=shinobi
# REQUIRED: set a strong token before running — server will not start without this
ADMIN_TOKEN=changeme

# Supervisor status page port (defaults to PORT+1, e.g. 8091 if PORT=8090)
# STATUS_PORT=8091
